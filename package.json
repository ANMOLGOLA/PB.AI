{
  "name": "sentinel-exam",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, smart proctoring browser and assessment platform",
  "workspaces": [
    "frontend",
    "apps/*"
  ],
  "scripts": {
    "start": "electron frontend",
    "frontend:dev": "npm run dev:renderer --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "frontend:check": "npm run typecheck --workspace=frontend",
    "frontend:install": "npm install --workspace=frontend",
    "desktop": "electron frontend",
    "desktop:run": "electron frontend",
    "desktop:dev": "npm run dev:renderer --workspace=frontend",
    "desktop:build": "npm run build --workspace=frontend",
    "desktop:check": "npm run typecheck --workspace=frontend",
    "desktop:install": "npm install --workspace=frontend",
    "proctor:build": "npm run build --workspace=apps/proctor-web",
    "proctor:check": "npm run typecheck --workspace=apps/proctor-web",
    "proctor:dev": "npm run dev --workspace=apps/proctor-web",
    "backend:seed": "python backend/app/seed.py",
    "backend:run": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "backend:test": "python -m pytest backend/tests -v",
    "test": "npm run backend:test && npm run frontend:check"
  }
}
